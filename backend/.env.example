ANTHROPIC_API_KEY=your_key_here

# Comma-separated origins allowed to call this API. Unset = any localhost port.
# In production set this to the deployed frontend origin, no trailing slash:
#   ALLOWED_ORIGINS=https://tinted.vercel.app
ALLOWED_ORIGINS=

# Optional regex for extra origins, e.g. Vercel preview deployments:
#   ALLOWED_ORIGIN_REGEX=https://tinted-[a-z0-9]+-stupnds-projects\.vercel\.app
ALLOWED_ORIGIN_REGEX=

# Hard ceiling on estimated Claude spend per UTC day. Paid endpoints return 503
# once this is crossed, resetting at midnight UTC.
DAILY_BUDGET_USD=5.00

# Upload limits
MAX_UPLOAD_BYTES=8388608
MAX_IMAGE_PIXELS=12000000

# Pricing used to estimate spend. Defaults match claude-haiku-4-5 ($1 / $5 per
# MTok). Update if the model changes.
CLAUDE_INPUT_PER_MTOK=1.00
CLAUDE_OUTPUT_PER_MTOK=5.00
